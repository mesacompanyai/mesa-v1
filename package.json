{
  "name": "mesa-cloud-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud backend, workers, queues, and media processing scaffold for Mesa.",
  "type": "commonjs",
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker:messages": "tsx watch apps/worker-messages/src/main.ts",
    "dev:worker:media": "tsx watch apps/worker-media/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker:messages": "node dist/apps/worker-messages/src/main.js",
    "start:worker:media": "node dist/apps/worker-media/src/main.js",
    "start:all": "sh -c 'node dist/apps/worker-messages/src/main.js & node dist/apps/worker-media/src/main.js & node dist/apps/api/src/main.js'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/s3-request-presigner": "3.1045.0",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.4.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.76.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "file-type": "22.0.1",
    "ioredis": "5.10.1",
    "openai": "6.37.0",
    "pdf-parse": "2.4.5",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
