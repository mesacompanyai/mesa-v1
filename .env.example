# Mesa API
NODE_ENV=development
MESA_SERVICE_ROLE=api
PORT=3000
PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Railway Postgres/Redis for Mesa
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mesa?schema=public
REDIS_URL=redis://localhost:6379

# Webhook security
EVOLUTION_WEBHOOK_SECRET=replace-with-random-secret

# Evolution API hosted on Railway
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_GLOBAL_API_KEY=replace-with-evolution-global-key

# Cloudflare R2 private media bucket
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=mesa-media
R2_PUBLIC_BASE_URL=

# OpenAI multimodal processing
OPENAI_API_KEY=replace-with-openai-key
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional observability
SENTRY_DSN=
